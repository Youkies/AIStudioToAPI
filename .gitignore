camoufox*.zip

# Authentication files
configs/auth/
auth-*.json
users.csv
cache/

# Credential store — plaintext passwords and TOTP seeds. It lives under
# configs/auth/ (the only persistent volume) but is spelled out here too so a
# stray copy elsewhere cannot be committed by accident.
configs/accounts.json
**/_accounts.json

# Usage statistics data
data/

# Temporary files
tmp/
temp/
ui/dist/
*.css
test/
debug_*.png
debug_*.html
proxylist.txt
proxy_mapping.json
